{
  "name": "amiao-sticker-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "A modern categorized reaction image gallery for Cloudflare Pages",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "rename-images": "bun run scripts/rename-images.js",
    "generate-gallery": "bun run scripts/generate-gallery.js",
    "generate-thumbs": "bun run scripts/generate-thumbs.js --width=400 --quality=80",
    "validate": "bun run scripts/validate-gallery.js",
    "sync-gallery": "bun run rename-images && bun run generate-thumbs && bun run generate-gallery && bun run validate"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "minimist": "^1.2.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-masonry-css": "^1.0.16",
    "sharp": "0.32.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
